
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default to denying all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Admins need to be authenticated
    // We're assuming any user logged in via email/password to the /admin/** routes is an admin.
    // A more secure way is to use custom claims.
    match /insurers/{insurerId} {
      allow read, write: if request.auth != null;
    }
    match /valuers/{valuerId} {
      allow read, write: if request.auth != null;
    }
    match /bookings/{bookingId} {
       allow read, write: if request.auth != null;
    }
     match /customers/{customerId} {
       allow read, write: if request.auth != null;
    }

    // Insurer-specific rules (non-admin client users)
    // They can read the main insurers list to find their own login details
    // but cannot write to it.
    match /insurers/{insurerId} {
      allow read: if request.auth == null; // For login check
    }

    // An insurer can manage customers that are linked to them.
    match /customers/{customerId} {
      allow read, create: if request.auth == null || (request.auth != null && request.resource.data.insurerId == request.auth.token.name);
    }
    
    // An insurer can manage bookings that are linked to them.
    match /bookings/{bookingId} {
      allow read, create: if request.auth == null || (request.auth != null && request.resource.data.insurerId == request.auth.token.name);
    }
  }
}

    