rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow unauthenticated reads for insurer login.
    // Writes are restricted to authenticated admins.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      // Admin can read all bookings
      // Insurer can read their own bookings
      allow read: if request.auth != null || 
                   (request.auth == null && get(/databases/$(database)/documents/insurers/$(request.resource.data.insurerId)).data.username == request.resource.data.insurerId);
      
      // Allow any authenticated user (admin or insurer) to create bookings
      // For insurers, we check if the provided insurerId in the booking matches their session identifier
      allow create: if request.auth != null || request.resource.data.insurerId != null;

      // Only admins can update or delete bookings
      allow update, delete: if request.auth != null;
    }

    // Default security rules for other collections.
    match /valuers/{valuerId} {
      allow read, write: if request.auth != null;
    }
    
    // Other collections can be added here
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
