rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Insurers collection:
    // Allow public read for login verification.
    // Only authenticated admins can create, update, or delete insurers.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Staff collection:
    // Allow public read for login verification.
    // Only authenticated admins can write.
    match /staff/{staffId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers collection:
    // Allow public read access for insurers to view their customer lists.
    // Writes are allowed for any authenticated user.
    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.insurerId == request.auth.uid;
    }

    // Bookings collection:
    // Allow public read access for all roles.
    // Writes (create, update) are allowed for any user.
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

  
    // Agents collection:
    // Allow public read for login.
    // Writes are restricted to the client who owns the agent.
    match /agents/{agentId} {
      allow read: if true;
      allow create, delete: if request.resource.data.clientId == request.auth.uid;
      allow update: if get(/databases/$(database)/documents/agents/$(agentId)).data.clientId == request.auth.uid;
    }
    
   // Valuers collection:
    // Allow public read for login verification.
    // Only authenticated admins can write.
    match /valuers/{valuerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Valuations collection:
    // Allow any user to create and read valuation reports.
    // Admin can update/delete.
    match /valuations/{valuationId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Branches collection:
    // Allow anyone to read the list of branches.
    match /branches/{branchId} {
        allow read: if true;
        allow write: if request.auth != null; // Only admins can add/edit branches
    }
  }
}
