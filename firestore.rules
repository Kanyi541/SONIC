rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins are authenticated via Firebase Auth.
    // Clients (Insurers) and Valuers are not, so we can't use request.auth for them directly
    // without custom claims. The app logic currently handles their "login".
    // A more secure implementation would use custom claims for roles.
    
    function isAdmin() {
      return request.auth != null;
    }

    // Insurers collection:
    // Allow public read for login verification.
    // Only authenticated admins can create, update, or delete insurers.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Agents collection:
    // Agents are managed by clients. A client can only manage their own agents.
    match /agents/{agentId} {
      allow read, write: if request.resource.data.clientId == request.auth.token.email;
    }


    // Customers collection:
    // Allow public read access for insurers to view their customer lists.
    // Writes are allowed only for the insurer who owns the customer.
    match /customers/{customerId} {
      allow read: if true; // Should be more specific in a real app
      allow write: if request.resource.data.insurerId == request.auth.token.email; // Assuming insurerId is their email/unique ID
    }

    // Bookings collection:
    // Allow admins to read all. Others can read if they are involved.
    // Logged-in users (clients) can create. Admins can update (approve/reject).
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if request.auth != null; // Any logged-in user (client)
      allow update: if isAdmin();
    }

   // Valuers collection:
    // Allow public read for login verification.
    // Only authenticated admins can write.
    match /valuers/{valuerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Valuations collection:
    // Any authenticated user (valuer) can create.
    // Only admins can update/delete.
    match /valuations/{valuationId} {
      allow read: if true;
      allow create: if request.auth != null; // Should ideally be restricted to 'valuer' role
      allow update, delete: if isAdmin();
    }
  }
}
