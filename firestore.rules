rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default to denying all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow admins full access to their data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Insurers can manage their own customers
    match /customers/{customerId} {
      allow read, create, update: if request.auth != null && request.resource.data.insurerId == request.auth.token.name;
    }
    
    // Insurers can manage their own bookings
    match /bookings/{bookingId} {
      allow read, create, update: if request.auth != null && request.resource.data.insurerId == request.auth.token.name;
    }
    
    // Anyone can read insurer data for login purposes, but only admins can modify
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists == true;
    }

    // Admins have full access to all data
    match /admins/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
    }
    
    // Valuers can read their assigned valuations
    match /valuations/{valuationId} {
       allow read, update: if request.auth != null && request.resource.data.valuerId == request.auth.uid;
    }
  }
}

    