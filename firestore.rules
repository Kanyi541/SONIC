rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow unauthenticated reads for insurer login.
    // Writes are restricted to authenticated admins.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      // Admin can read all bookings.
      // A non-admin can only read if the booking's insurerId matches the resource data (for insurer dashboard).
      // This is less secure as it relies on client-side checks, but fits the current auth model.
      // A better implementation would use Firebase Auth for insurers.
      allow read: if request.auth != null || resource.data.insurerId == request.query.get("insurerId");
      
      // Allow any user to create bookings (assumes they are a logged-in insurer).
      allow create: if true;
      
      // Only admins can update or delete bookings.
      allow update, delete: if request.auth != null;
    }

    // Default security rules for other collections.
    match /valuers/{valuerId} {
      allow read, write: if request.auth != null;
    }
    
    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
