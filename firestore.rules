rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Insurers collection:
    // Allow public read for login verification.
    // Only authenticated admins can create, update, or delete insurers.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers collection:
    // Allow public read access for insurers to view their customer lists.
    // Writes are allowed for any user (representing a logged-in insurer).
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection:
    // Allow public read access for insurers to view their bookings.
    // Writes are allowed for any user (representing a logged-in insurer).
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Valuers collection:
    // Restricted to authenticated admin users.
    match /valuers/{valuerId} {
      allow read, write: if request.auth != null;
    }
  }
}
