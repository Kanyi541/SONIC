rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Insurers collection
    match /insurers/{insurerId} {
      // Admins can manage all insurers
      // Authenticated users can read insurer data (for login)
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      // Admins can manage all customers
      // Authenticated users can manage customers linked to their insurerId
      allow read, create: if isAdmin() || (request.auth != null && request.resource.data.insurerId == request.auth.token.name);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.insurerId == request.auth.token.name);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Admins can manage all bookings
      // Authenticated users can manage bookings linked to their insurerId
      allow read, create: if isAdmin() || (request.auth != null && request.resource.data.insurerId == request.auth.token.name);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.insurerId == request.auth.token.name);
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
