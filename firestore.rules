
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Insurers collection:
    // Allow public read for login.
    // Allow admin to write anything.
    // Allow non-admins to create new users (agents/clients) but not update existing ones.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null; // Admin can do anything
      allow create: if request.auth == null; // Client-side logic handles user creation
    }
    
    // Staff collection:
    // Allow public read for login.
    // Allow admin to write anything.
    // Allow non-admins to create new staff.
    match /staff/{staffId} {
      allow read: if true;
      allow write: if request.auth != null; // Admin can do anything
      allow create: if request.auth == null; // Client-side logic handles staff creation
    }

    // Customers collection:
    // Allow read for anyone.
    // Writes are allowed for any user, as logic is handled client-side.
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection:
    // Allow public read access for all roles.
    // Writes (create, update) are allowed for any user.
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Valuers collection:
    // Allow public read for login verification.
    // Only authenticated admins can write.
    match /valuers/{valuerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Valuations collection:
    // Allow any user to create and read valuation reports.
    // Admin can update/delete.
    match /valuations/{valuationId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Branches collection:
    // Allow anyone to read the list of branches.
    match /branches/{branchId} {
        allow read: if true;
        allow write: if request.auth != null; // Only admins can add/edit branches
    }

    // Uploads collection:
    // Allow any user to create (upload) and read images.
    match /uploads/{uploadId} {
      allow read, create: if true;
    }

    // Archives collection:
    // Only backend processes (like our GitHub action) should write here.
    // Only admins should be able to read for analytics.
    match /archives/{archiveId} {
      allow read: if request.auth != null;
      allow write: if false; // Prevent client-side writes
    }
  }
}
