rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Insurers collection:
    // Allow public read for login verification.
    // Only authenticated admins can create, update, or delete insurers.
    match /insurers/{insurerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customers collection:
    // Allow public read access for insurers to view their customer lists.
    // Writes are allowed for any user (representing a logged-in insurer).
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection:
    // Allow public read access for all roles.
    // Writes (create, update) are allowed for any user.
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

  
    // Agents collection:
    // Allow public read access for clients to view their agent lists.
    // Writes are allowed for any user (representing a logged-in client).
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }
    
   // Valuers collection:
    // Allow public read for login verification.
    // Only authenticated admins can write.
    match /valuers/{valuerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Valuations collection:
    // Allow any user to create and read valuation reports.
    match /valuations/{valuationId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}