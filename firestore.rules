rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin-only collections
    match /valuers/{docId} {
      allow read, write: if request.auth != null;
    }

    // Insurers collection
    // Allow read for login check, but restrict writes to admins.
    match /insurers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer collection
    // Allow an insurer to create customers.
    // An insurer can only read customers linked to them.
    match /customers/{docId} {
      allow create: if true;
      allow read: if resource.data.insurerId == request.query.get("insurerUsername");
    }

    // Bookings collection
    // Allow an insurer to create bookings.
    // An insurer can only read bookings linked to them.
    match /bookings/{docId} {
       allow create: if true;
       allow read: if resource.data.insurerId == request.query.get("insurerUsername");
       allow update, delete: if request.auth != null; // Only admin can update/delete
    }
  }
}
