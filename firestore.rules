rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default to denying all access.
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins (any authenticated user via Firebase Auth) can manage insurers.
    // This assumes anyone who can sign into the admin panel is a trusted admin.
    match /insurers/{insurerId} {
      allow read, write: if request.auth != null;
    }
    
    // Admins can read all bookings.
    // Insurers can read/write bookings linked to their username.
    match /bookings/{bookingId} {
      // Admin access
      allow read: if request.auth != null;
      // Insurer access
      allow create: if request.auth == null && request.resource.data.insurerId == request.resource.data.insurerId; // Allow from client dashboard
      allow read, update: if request.auth == null && get(/databases/$(database)/documents/bookings/$(bookingId)).data.insurerId == request.resource.data.insurerId;
    }

    // Insurers can manage customers linked to their username.
    match /customers/{customerId} {
      allow read, create: if request.auth == null; // Allow from client dashboard
    }
  }
}
