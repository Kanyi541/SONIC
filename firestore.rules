rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow unauthenticated reads for client login.
    // Writes are restricted to authenticated users (e.g., the admin).
    match /clients/{clientId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow any user (including the non-Firebase-authenticated client)
    // to read the customer list and create new bookings.
    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Default security rules for other collections.
    match /valuers/{valuerId} {
      allow read, write: if request.auth != null;
    }
  }
}